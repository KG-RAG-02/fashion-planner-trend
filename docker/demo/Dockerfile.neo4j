# 그래프 데이터(정답 라벨 5건의 Style·Item + 무신사 Product 02·03)를 구워 넣은 Neo4j 이미지.
# 만드는 법: docker/demo/build.sh (현재 그래프를 덤프해서 이 파일로 이미지를 만든다)
#
# 주의
#  - 기반 이미지가 /data, /logs를 VOLUME으로 선언하고 있어 거기에 구우면 데이터가 버려진다. 그래서 /baked를 쓴다.
#  - 인증을 끄고(NEO4J_AUTH=none) 비밀번호를 이미지에 넣지 않는다. 로컬 확인용이며 포트는 127.0.0.1에만 연다 (compose).
#  - 컨테이너를 지우면(docker compose --profile demo down) 데이터는 구워 넣은 시점으로 돌아간다.
#  - 이미지의 CPU 아키텍처는 build.sh의 PLATFORM(기본: 빌드한 PC)을 따른다. Windows·Intel용은 PLATFORM=linux/amd64, Apple Silicon용은 linux/arm64.
FROM neo4j:5.26-community AS loader
COPY dump/neo4j.dump /tmp/dump/neo4j.dump
RUN mkdir -p /baked/data /baked/logs \
 && printf 'server.directories.data=/baked/data\nserver.directories.logs=/baked/logs\n' > /tmp/baked.conf \
 && neo4j-admin database load neo4j --from-path=/tmp/dump --overwrite-destination=true --additional-config=/tmp/baked.conf \
 && chown -R neo4j:neo4j /baked

FROM neo4j:5.26-community
COPY --from=loader --chown=neo4j:neo4j /baked /baked
ENV NEO4J_server_directories_data=/baked/data \
    NEO4J_server_directories_logs=/baked/logs \
    NEO4J_AUTH=none \
    NEO4J_server_memory_heap_initial__size=512m \
    NEO4J_server_memory_heap_max__size=1G \
    NEO4J_server_memory_pagecache_size=512m
