# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environment
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# Data (원본·가공 데이터는 커밋하지 않음, 샘플만 허용)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Neo4j local data
neo4j/data/
neo4j/logs/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
logs/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 평가 데이터: 라벨(Vogue 인용 포함)과 실행 결과는 커밋하지 않는다. 기준 문서와 매니페스트만 커밋한다.
eval/datasets/**/labels/*
!eval/datasets/**/labels/.gitkeep
eval/datasets/**/review/*
eval/results/*
!eval/results/.gitkeep


# 라벨을 압축한 파일도 제외 (Vogue 인용 포함, 팀 내부 전달용)
eval/datasets/**/*.zip

# iCloud Drive conflict copies (e.g. "server 2.py"); never commit them.
* [0-9]
* [0-9].*
