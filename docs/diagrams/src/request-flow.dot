// 요청 처리 흐름: HTTP 봉투 → TrendQuery → Style → Item → 상품 후보 → 점수 → 근거 → 결과.
// 색은 @TOKEN@ 자리표시자이고 scripts/render_diagrams.sh가 바꾼다. 근거는 docs/diagrams/CLAIMS.md.
digraph request_flow {
  graph [rankdir=TB, bgcolor="@BG@", fontname="Pretendard", fontcolor="@FG@", nodesep=0.35, ranksep=0.32, pad=0.3];
  node  [fontname="Pretendard", fontsize=12, fontcolor="@FG@", color="@SVC_LINE@", fillcolor="@SVC_FILL@",
         style="rounded,filled", shape=box, penwidth=1.3, margin="0.20,0.08", width=3.6];
  edge  [fontname="Pretendard", fontsize=10, fontcolor="@FG@", color="@FG@", penwidth=1.1, arrowsize=0.7];

  req     [label="POST @ROUTE@\n{contract_version, request_id, input: TrendQuery}", penwidth=2];
  auth    [label="Bearer 토큰 확인\n(상수 시간 비교)"];
  valid   [label="봉투 + TrendQuery 검증\ncontract_version · request_id 일치 · pydantic"];
  styles  [label="1  Style\n모든 Style을 읽어 시즌 일치 확인\n(+ 트렌드명이 있으면 이름 일치)"];
  items   [label="2  Style별 Item\n카테고리 포함·제외 → 요청 속성 필터"];
  cands   [label="3  Item별 상품 후보\n상분류가 같고 (하분류 | fit |\n공유 Color/Material/Pattern/Detail 노드) 중 하나 일치\n근사(approx) 값은 쓰지 않음"];
  score   [label="점수 = Σ w·ratio ÷ Σ w  +  α (하분류 일치)\nw = 기본 가중치 × 핵심 2.0 / 보조 1.5 배수\n상품에 없는 속성은 분모에서 빠짐"];
  evid    [label="4  근거\nEVIDENCED_BY → evidence_id = trend:<article>:<block>:<sha8>"];
  ok      [label="200  {contract_version, request_id, producer, status: ok, result}", penwidth=2];

  e401    [label="401 unauthorized", style="rounded,dashed", color="@ERR@", fontcolor="@ERR@", fillcolor="@BG@", width=1.8];
  e400    [label="400 invalid_request /\nunsupported_contract_version /\ninvalid_trend_query", style="rounded,dashed", color="@ERR@", fontcolor="@ERR@", fillcolor="@BG@", width=1.8];
  nores   [label="200  status: no_results\n+ limitations[] (사유)", style="rounded,dashed", color="@ERR@", fontcolor="@ERR@", fillcolor="@BG@", width=1.8];
  e503    [label="503 search_unavailable\n(Neo4j·검색 오류)", style="rounded,dashed", color="@ERR@", fontcolor="@ERR@", fillcolor="@BG@", width=1.8];

  req -> auth -> valid -> styles -> items -> cands -> score -> evid -> ok;

  auth   -> e401  [style=dashed, color="@ERR@", label="없음·불일치", fontcolor="@ERR@"];
  valid  -> e400  [style=dashed, color="@ERR@", label="형식 오류", fontcolor="@ERR@"];
  styles -> nores [style=dashed, color="@ERR@", label="이름·시즌 불일치,\nItem 없음", fontcolor="@ERR@"];
  items  -> nores [style=dashed, color="@ERR@", fontcolor="@ERR@"];
  score  -> nores [style=dashed, color="@ERR@", label="통과한 것 없음", fontcolor="@ERR@"];
  styles -> e503  [style=dashed, color="@ERR@", label="예외", fontcolor="@ERR@"];

  {rank=same; auth; e401}
  {rank=same; valid; e400}
  {rank=same; items; nores}
}
