# 이 파일은 `.env`로 복사해 쓰는 양식이다. 여기에는 값을 채우지 않는다 (주소·포트·모델명·비밀번호 모두 각자 `.env`에만 쓴다).
# `.env`는 커밋하지 않는다. 변수별 설명은 README "환경변수" 표.

# Neo4j (비워 두면 코드가 로컬 Neo4j 기본값을 쓴다. NEO4J_PASSWORD는 필수)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# LLM (기사 정보 추출 / 쿼리 전처리 / Tier4). 백엔드: codex_cli(구독 Codex CLI, 기본) | openai_api(LLM_API_KEY 필요)
LLM_BACKEND=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=
# 선택: 캐시·호출 로그 위치 (비우면 구현 기본값)
# LLM_CACHE_DIR=
# LLM_CALL_LOG=

# 로컬 임베딩 (선택): 벡터 parquet·manifest 위치 (비우면 구현 기본값). 모델 캐시는 HF_HOME
# VOGUE_EMBEDDINGS_DIR=

# Neo4j docker-compose 선택 설정. 이미 쓰는 Neo4j와 포트가 겹칠 때만 채운다 (바꾸면 NEO4J_URI의 포트도 같이 바꾼다).
# NEO4J_BOLT_PORT=
# NEO4J_HTTP_PORT=
