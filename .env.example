# 이 파일은 `.env`로 복사해 쓰는 양식이다. 여기에는 값을 채우지 않는다 (주소·포트·모델명·비밀번호 모두 각자 `.env`에만 쓴다).
# `.env`는 커밋하지 않는다. 변수별 설명은 README의 설정 표.

# Neo4j (비워 두면 코드가 로컬 Neo4j 기본값을 쓴다. NEO4J_PASSWORD는 필수)
# Aura(클라우드): NEO4J_URI=neo4j+s://<인스턴스 id>.databases.neo4j.io, NEO4J_USER에는 Aura 접속 정보 파일의 NEO4J_USERNAME 값
# 테스트(pytest -m neo4j)는 NEO4J_TEST_URI(로컬 7688)만 쓴다. Aura를 가리키면 conftest가 실패시킨다(그래프를 비우기 때문)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# LLM (기사 정보 추출). OpenAI API를 쓴다. LLM_MODEL은 필수이고 코드에 기본값이 없다.
LLM_API_KEY=
LLM_MODEL=
# 선택: 기본 추론 강도(추론 모델만, 등록표 configs/llm_models.yaml의 efforts 중). LLM_MODEL을 쓸 때만 적용된다 (docs/extraction.md)
# LLM_REASONING_EFFORT=
# 선택: 호출당 제한 시간(초), 캐시·호출 로그 위치 (비우면 구현 기본값: data/processed/llm/)
# LLM_TIMEOUT_S=
# LLM_CACHE_DIR=
# LLM_CALL_LOG=

# 로컬 임베딩(BAAI/bge-m3): 모델 캐시는 Hugging Face 기본 위치이고, 바꾸려면 HF_HOME을 설정한다.

# Neo4j docker-compose 선택 설정. 이미 쓰는 Neo4j와 포트가 겹칠 때만 채운다 (바꾸면 NEO4J_URI의 포트도 같이 바꾼다).
# NEO4J_BOLT_PORT=
# NEO4J_HTTP_PORT=

# HTTP API: process env overrides dotenv, including explicitly empty values.
# Empty host/port/mode use local defaults. FASHION_PLANNER_SERVICE_TOKEN is the shared bearer token
# required by the canonical /runs route: empty disables access, and service mode refuses to start without it.
FASHION_PLANNER_SERVICE_TOKEN=
TREND_API_HOST=127.0.0.1
TREND_API_PORT=8768
TREND_API_MODE=local
